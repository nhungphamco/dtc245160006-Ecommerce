logging {
  level = "info"
}

discovery.docker "minishop" {
  host = "unix:///var/run/docker.sock"
  refresh_interval = "30s"

  filter {
    name = "label"
    values = ["com.docker.compose.project=ecommerce"]
  }
}

discovery.relabel "minishop_logs" {
  targets = discovery.docker.minishop.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex = "nginx|backend"
    action = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    target_label = "container"
    replacement = "$1"
  }

  rule {
    target_label = "project"
    replacement = "minishop"
  }

  rule {
    target_label = "job"
    replacement = "docker"
  }
}

loki.source.docker "minishop" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.minishop_logs.output
  labels = {}
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
